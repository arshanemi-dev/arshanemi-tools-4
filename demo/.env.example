# Supabase project that owns the `media` Storage bucket.
# The rules file is saved as media/marketplace_rules.json (see lib/rulesStore.js).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Server-only — used by app/api/rules/route.js. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Optional — storage bucket to use instead of the default `media` (e.g. a staging bucket).
# The bucket is created (private) automatically if it doesn't exist.
# SUPABASE_MEDIA_BUCKET="media"

# Not used by the app today (kept for parity with the other Barmeto apps).
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
